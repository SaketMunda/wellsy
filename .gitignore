# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/
build/
dist/

# Per-run artifacts (provenance log, benchmark output)
runs/

# Model weights — cached outside the repo at ~/.cache/wellsy/weights, this is
# defence in depth in case a download ever lands here.
*.pt
*.ts
weights/

# OS / editor
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea

# Secrets (API keys). Never commit.
.env
.env.*

# Playwright MCP output, if it is ever run from the repo
.playwright-mcp/

# Pipecat eval harness logs (`pipecat eval run` writes them to the cwd by default)
*.eval.log
*.debug.log
